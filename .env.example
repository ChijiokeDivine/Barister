# ─────────────────────────────────────────────────────────────────────────────
# Legal Flow — environment variables. Copy to .env.local and fill in.
# Only the first two groups are required to run locally; the rest enable features.
# ─────────────────────────────────────────────────────────────────────────────

# ── Security (REQUIRED) ──────────────────────────────────────────────────────
# Bearer token every /api/* route expects (Authorization: Bearer <key> or x-api-key).
# Placeholder auth until a real identity provider is wired in. Unset in production = all requests rejected.
APP_API_KEY=change-me-to-a-long-random-string

# 32-byte base64 key for AES-256-GCM encryption at rest (documents, redaction maps, chats, outputs).
# Generate: openssl rand -base64 32
# Rotating this key makes previously stored data unreadable — back it up.
VAULT_ENCRYPTION_KEY=

# ── LLM providers ────────────────────────────────────────────────────────────
# Google AI Studio (https://aistudio.google.com/apikey) — long-context work: timeline extraction, contradiction analysis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Cheaper/faster Gemini used as fallback when Groq is down or a prompt exceeds Groq's context.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Groq (https://console.groq.com/keys) — fast generation: question drafting, chat, workflow generation.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Small model for cheap classification/routing steps.
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Free tiers are rate limited; keep concurrent LLM calls low.
LLM_CONCURRENCY=2
# Characters per Gemini extraction chunk (~4 chars/token). 240000 ≈ 60k tokens, safely under free-tier TPM bursts.
GEMINI_CHUNK_CHARS=240000
# Max chars of document context allowed into a Groq prompt (≈ its 131k-token window minus headroom).
GROQ_MAX_CONTEXT_CHARS=300000

# ── Web3 proof layer (Ethereum Sepolia) ──────────────────────────────────────
# Public RPC works for testing; use Alchemy/Infura for reliability.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Throwaway TESTNET-ONLY private key (0x…) funded from a Sepolia faucet. NEVER use a mainnet key.
# Server-side relayer: it pays gas to anchor SHA-256 hashes as calldata.
ANCHOR_PRIVATE_KEY=

# ── Storage ──────────────────────────────────────────────────────────────────
# file  = local ./.data directory (dev only; Vercel's filesystem is ephemeral)
# cloud = Upstash Redis (metadata) + Vercel Blob (encrypted file bodies)
# Leave unset to auto-pick: cloud if the tokens below exist, otherwise file.
STORAGE_DRIVER=
# Upstash Redis (Vercel Marketplace → Upstash, free tier)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Blob (Storage tab in the Vercel dashboard)
BLOB_READ_WRITE_TOKEN=

# Max direct-upload size in MB. Vercel functions cap request bodies at ~4.5MB;
# larger discovery sets must use the Blob client-upload flow (/api/documents/upload-token).
MAX_UPLOAD_MB=4
# Ceiling for the Blob client-upload flow (cloud storage only). Parsing happens in one serverless function, so keep it modest.
MAX_LARGE_UPLOAD_MB=50
